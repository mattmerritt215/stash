# Example /etc/stash/env for stash-multiuser.
#
# Referenced by systemd as EnvironmentFile= in stash.service. Keep this file
# readable only by root and the stash service user (chmod 640, chown
# root:stash) since it can hold an OIDC client secret.
#
# None of this touches stash's own config.yml -- STASH_AUTH_MODE unset (or
# "disabled") makes the binary behave exactly like stock, single-user stash.
# See pkg/auth/config.go for the authoritative source of every variable
# below, and FORK.md for the roles/permissions this configures.

# -----------------------------------------------------------------------------
# STASH_AUTH_MODE selects one of:
#   disabled  - stock single-user stash (default if unset)
#   oidc      - sign in via an external identity provider (Authentik, Keycloak, etc.)
#   header    - trust identity headers set by a reverse proxy doing its own auth
#   hybrid    - accept trusted-proxy headers first, fall back to OIDC
# -----------------------------------------------------------------------------
STASH_AUTH_MODE=disabled

# -----------------------------------------------------------------------------
# OIDC mode (required when STASH_AUTH_MODE is oidc or hybrid)
# -----------------------------------------------------------------------------

# Issuer URL, copied byte-for-byte from your IdP's well-known document --
# including a trailing slash if the IdP's "issuer" field has one (Authentik
# does). Do not "clean up" trailing slashes yourself; a mismatch here breaks
# discovery.
#STASH_OIDC_ISSUER=https://auth.example.com/application/o/stash/

#STASH_OIDC_CLIENT_ID=stash
#STASH_OIDC_CLIENT_SECRET=changeme

# Where the IdP redirects back to after login. Must exactly match what's
# registered on the IdP side.
#STASH_OIDC_REDIRECT_URL=https://stash.example.com/auth/callback

# Space- or comma-separated. Default: "openid profile email groups"
#STASH_OIDC_SCOPES=openid profile email groups

# Which claim in the ID token maps to each field. Defaults shown.
#STASH_OIDC_USERNAME_CLAIM=preferred_username
#STASH_OIDC_EMAIL_CLAIM=email
#STASH_OIDC_NAME_CLAIM=name
#STASH_OIDC_GROUPS_CLAIM=groups

# Group names (comma- or space-separated) that map to each role. Defaults
# shown. A user matching neither falls through to STASH_AUTH_DEFAULT_ROLE.
#STASH_OIDC_ADMIN_GROUPS=stash-admins
#STASH_OIDC_USER_GROUPS=stash-users

# Create a local stash user record automatically on first successful OIDC
# login. Default: true.
#STASH_OIDC_AUTO_CREATE=true

# Also log the user out of the IdP (OIDC RP-initiated logout) when they log
# out of stash. Default: true.
#STASH_OIDC_END_SESSION=true

# Skip TLS certificate verification against the IdP. Only for testing against
# a self-signed IdP; never enable this in production. Default: false.
#STASH_OIDC_INSECURE_SKIP_VERIFY=false

# -----------------------------------------------------------------------------
# Header mode (required when STASH_AUTH_MODE is header or hybrid)
# -----------------------------------------------------------------------------

# Header names your reverse proxy sets after authenticating the user.
# Defaults shown match Authentik's forward-auth outpost headers.
#STASH_AUTH_HEADER_USER=X-Authentik-Username
#STASH_AUTH_HEADER_GROUPS=X-Authentik-Groups
#STASH_AUTH_HEADER_EMAIL=X-Authentik-Email
#STASH_AUTH_HEADER_NAME=X-Authentik-Name

# Separator used within the groups header. Default: "|"
#STASH_AUTH_HEADER_GROUP_SEPARATOR=|

# REQUIRED whenever header auth is active (header or hybrid mode): a
# comma/space-separated list of IPs or CIDRs allowed to set identity headers.
# Stash refuses to start with header auth enabled and this empty -- there is
# no safe default, since trusting headers from an untrusted peer lets anyone
# log in as anyone. Set this to your reverse proxy's address(es) only.
#STASH_AUTH_TRUSTED_PROXIES=127.0.0.1,::1

# -----------------------------------------------------------------------------
# Common to any non-disabled mode
# -----------------------------------------------------------------------------

# Role assigned to an authenticated user matching neither AdminGroups nor
# UserGroups. One of: admin, user, guest. Empty/unset means "reject" (the
# user authenticates but is refused a session). No default.
#STASH_AUTH_DEFAULT_ROLE=guest

# Keep the upstream username/password login form (/login) available as a
# break-glass path, authenticating against the local admin credentials in
# config.yml. That local admin (user row 1) can never be demoted, disabled,
# or deleted. Default: true. Only disable this if you're confident OIDC/your
# proxy can never lock you out.
#STASH_AUTH_LOCAL_LOGIN=true

# OIDC session cookie lifetime in seconds. Default: 604800 (7 days).
#STASH_AUTH_SESSION_MAX_AGE=604800
